{
  // Hand-written (PLAN.md 7a). Same reasoning as locking_arm: the run is
  // deterministic and poses use 1e-10. The collapse swings through large
  // angles and tendon slack/taut events, which magnify a reordering-sized
  // change somewhat; 1e-10 still leaves room above the ~1e-12 change seen
  // when dt is halved.
  "time": { "absolute": 1e-12, "relative": 0 },
  "upper_x": { "absolute": 1e-10, "relative": 0 },
  "upper_y": { "absolute": 1e-10, "relative": 0 },
  "upper_theta": { "absolute": 1e-10, "relative": 0 },
  "lower_x": { "absolute": 1e-10, "relative": 0 },
  "lower_y": { "absolute": 1e-10, "relative": 0 },
  "lower_theta": { "absolute": 1e-10, "relative": 0 },
  "tension_shoulder_tendon": { "absolute": 1e-6, "relative": 1e-9 },
  "tension_elbow_tendon": { "absolute": 1e-6, "relative": 1e-9 },
  "reaction_shoulder_x": { "absolute": 1e-6, "relative": 1e-9 },
  "reaction_shoulder_y": { "absolute": 1e-6, "relative": 1e-9 },
  "reaction_elbow_x": { "absolute": 1e-6, "relative": 1e-9 },
  "reaction_elbow_y": { "absolute": 1e-6, "relative": 1e-9 },
  "kinetic_energy": { "absolute": 1e-10, "relative": 1e-10 },
  "potential_energy": { "absolute": 1e-10, "relative": 1e-10 },
  "elastic_energy": { "absolute": 1e-10, "relative": 1e-10 },
  "dissipated_energy": { "absolute": 1e-10, "relative": 1e-10 },
  // Worst |E_total(t) - E_total(0)|, J. Measured 5.2e-13 over 2 s in the
  // dt study.
  "max_energy_balance_error": { "absolute": 5e-12, "relative": 0 },
  // Worst pin position error, m. Measured ~4e-14.
  "max_pin_residual": { "absolute": 1e-12, "relative": 0 },
  // Run-wide extremes of the elbow joint angle (rad) and of its fold-stop
  // torque magnitude (N m), checked at every step because a stop strike
  // lasts about one 0.05 s sample. Angles as poses; torque as tensions.
  "min_joint_angle_elbow": { "absolute": 1e-10, "relative": 0 },
  "max_joint_angle_elbow": { "absolute": 1e-10, "relative": 0 },
  "max_limit_torque_elbow": { "absolute": 1e-8, "relative": 1e-9 },
  // Tendon slack/taut and fold-stop switches. A change here means the
  // collapse changed.
  "event_count": { "absolute": 0, "relative": 0 },
  "unresolved_steps": { "absolute": 0, "relative": 0 }
}
