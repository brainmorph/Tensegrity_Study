{
  // Hand-written (PLAN.md 7a), following toggle_arm_snap. The run is
  // deterministic, but the snap is a fall over center that magnifies any
  // rounding change, so poses use 1e-9 rather than 1e-10. The top cables
  // (k = EA / L0 = 2500 N/m) magnify a pose change into tensions and pin
  // reactions of up to ~1e-5 N.
  "time": { "absolute": 1e-12, "relative": 0 },
  "post1_x": { "absolute": 1e-9, "relative": 0 },
  "post1_y": { "absolute": 1e-9, "relative": 0 },
  "post1_theta": { "absolute": 1e-9, "relative": 0 },
  "post2_x": { "absolute": 1e-9, "relative": 0 },
  "post2_y": { "absolute": 1e-9, "relative": 0 },
  "post2_theta": { "absolute": 1e-9, "relative": 0 },
  "post3_x": { "absolute": 1e-9, "relative": 0 },
  "post3_y": { "absolute": 1e-9, "relative": 0 },
  "post3_theta": { "absolute": 1e-9, "relative": 0 },
  "tension_c12": { "absolute": 1e-5, "relative": 1e-9 },
  "tension_c23": { "absolute": 1e-5, "relative": 1e-9 },
  "tension_stay": { "absolute": 1e-5, "relative": 1e-9 },
  "tension_guy": { "absolute": 1e-5, "relative": 1e-9 },
  "tension_muscle": { "absolute": 1e-5, "relative": 1e-9 },
  // The muscle's contractile length follows its activation alone, so only
  // rounding can change it.
  "contractile_muscle": { "absolute": 1e-12, "relative": 0 },
  "reaction_foot1_x": { "absolute": 1e-5, "relative": 1e-9 },
  "reaction_foot1_y": { "absolute": 1e-5, "relative": 1e-9 },
  "reaction_foot2_x": { "absolute": 1e-5, "relative": 1e-9 },
  "reaction_foot2_y": { "absolute": 1e-5, "relative": 1e-9 },
  "reaction_foot3_x": { "absolute": 1e-5, "relative": 1e-9 },
  "reaction_foot3_y": { "absolute": 1e-5, "relative": 1e-9 },
  "kinetic_energy": { "absolute": 1e-9, "relative": 1e-10 },
  "potential_energy": { "absolute": 1e-9, "relative": 1e-10 },
  "elastic_energy": { "absolute": 1e-9, "relative": 1e-10 },
  "dissipated_energy": { "absolute": 1e-9, "relative": 1e-10 },
  // Work done by the muscle, J.
  "actuator_work": { "absolute": 1e-9, "relative": 1e-10 },
  // Worst |E_total(t) - E_total(0)|, J. Measured 1.5e-11 at dt 1e-4.
  "max_energy_balance_error": { "absolute": 5e-12, "relative": 0 },
  "max_pin_residual": { "absolute": 1e-13, "relative": 0 },
  // Activation breakpoints and cable slack/taut switches.
  "event_count": { "absolute": 0, "relative": 0 },
  "unresolved_steps": { "absolute": 0, "relative": 0 },
  // The statics' predictions (ThreeStrutStatics). The snap is bisected to
  // 1e-10 m of shortening, worth ~5e-8 N of muscle tension at k = 500 N/m;
  // the snapped shape is settled until the gradient is below 1e-13.
  "snap_shortening": { "absolute": 1e-9, "relative": 0 },
  "snap_muscle_tension": { "absolute": 1e-6, "relative": 0 },
  "snap_leans": { "absolute": 1e-8, "relative": 0 },
  "snapped_leans": { "absolute": 1e-10, "relative": 0 },
  "snapped_muscle_tension": { "absolute": 1e-8, "relative": 0 }
}
