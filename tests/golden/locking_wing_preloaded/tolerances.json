{
  // Hand-written (PLAN.md 7a), following locking_wing: the run is
  // deterministic, so poses use 1e-10, and tendon stiffness magnifies a
  // pose change into tensions and reactions of up to ~1e-6 N.
  "time": { "absolute": 1e-12, "relative": 0 },
  "upper_x": { "absolute": 1e-10, "relative": 0 },
  "upper_y": { "absolute": 1e-10, "relative": 0 },
  "upper_theta": { "absolute": 1e-10, "relative": 0 },
  "lower_x": { "absolute": 1e-10, "relative": 0 },
  "lower_y": { "absolute": 1e-10, "relative": 0 },
  "lower_theta": { "absolute": 1e-10, "relative": 0 },
  "hand_x": { "absolute": 1e-10, "relative": 0 },
  "hand_y": { "absolute": 1e-10, "relative": 0 },
  "hand_theta": { "absolute": 1e-10, "relative": 0 },
  "tension_shoulder_tendon": { "absolute": 1e-6, "relative": 1e-9 },
  "tension_elbow_tendon": { "absolute": 1e-6, "relative": 1e-9 },
  "tension_wrist_tendon": { "absolute": 1e-6, "relative": 1e-9 },
  "reaction_shoulder_x": { "absolute": 1e-6, "relative": 1e-9 },
  "reaction_shoulder_y": { "absolute": 1e-6, "relative": 1e-9 },
  "reaction_elbow_x": { "absolute": 1e-6, "relative": 1e-9 },
  "reaction_elbow_y": { "absolute": 1e-6, "relative": 1e-9 },
  "reaction_wrist_x": { "absolute": 1e-6, "relative": 1e-9 },
  "reaction_wrist_y": { "absolute": 1e-6, "relative": 1e-9 },
  "kinetic_energy": { "absolute": 1e-10, "relative": 1e-10 },
  "potential_energy": { "absolute": 1e-10, "relative": 1e-10 },
  "elastic_energy": { "absolute": 1e-10, "relative": 1e-10 },
  "dissipated_energy": { "absolute": 1e-10, "relative": 1e-10 },
  // Work done by the gust, J.
  "external_work": { "absolute": 1e-10, "relative": 1e-10 },
  // Worst |E_total(t) - E_total(0)|, J. Measured 6.3e-10 over 2 s in the
  // dt study (falls 16x per dt halving), as for locking_wing.
  "max_energy_balance_error": { "absolute": 5e-11, "relative": 0 },
  "max_pin_residual": { "absolute": 1e-13, "relative": 0 },
  // Run-wide extremes of each joint angle (rad) and its stop torque (N m),
  // checked at every step. Only the elbow and wrist have stops. Their
  // hyperextension stops carry the preload throughout and catch the
  // rebound; the fold stops are not reached.
  "min_joint_angle_shoulder": { "absolute": 1e-10, "relative": 0 },
  "max_joint_angle_shoulder": { "absolute": 1e-10, "relative": 0 },
  "max_limit_torque_shoulder": { "absolute": 1e-8, "relative": 1e-9 },
  "min_joint_angle_elbow": { "absolute": 1e-10, "relative": 0 },
  "max_joint_angle_elbow": { "absolute": 1e-10, "relative": 0 },
  "max_limit_torque_elbow": { "absolute": 1e-8, "relative": 1e-9 },
  "min_joint_angle_wrist": { "absolute": 1e-10, "relative": 0 },
  "max_joint_angle_wrist": { "absolute": 1e-10, "relative": 0 },
  "max_limit_torque_wrist": { "absolute": 1e-8, "relative": 1e-9 },
  // Gust breakpoints, tendon slack/taut and stop contact switches.
  "event_count": { "absolute": 0, "relative": 0 },
  "unresolved_steps": { "absolute": 0, "relative": 0 },
  // Holding torque at the straight pose, N m: zero by construction.
  "holding_torque_shoulder": { "absolute": 1e-12, "relative": 0 },
  "holding_torque_elbow": { "absolute": 1e-12, "relative": 0 },
  "holding_torque_wrist": { "absolute": 1e-12, "relative": 0 },
  // Stop torques on the hand and lower link at the straight pose, N m:
  // minus the preloads by construction.
  "preload_torque_elbow": { "absolute": 1e-12, "relative": 0 },
  "preload_torque_wrist": { "absolute": 1e-12, "relative": 0 },
  // Predicted lock thresholds (rest-length scales) from ChainStatics, with
  // the stops.
  "lock_threshold_shoulder": { "absolute": 1e-9, "relative": 0 },
  "lock_threshold_elbow": { "absolute": 1e-9, "relative": 0 },
  "lock_threshold_wrist": { "absolute": 1e-9, "relative": 0 }
}
