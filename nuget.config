<?xml version="1.0" encoding="utf-8"?>
<!--
  Project constraint 1 (PLAN.md section 1a): no third-party downloads.
  All remote sources are cleared; restore resolves only from the local
  NuGet global cache. A package missing from the cache fails the restore
  instead of silently downloading it.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-cache" value="%USERPROFILE%/.nuget/packages" />
  </packageSources>
</configuration>
